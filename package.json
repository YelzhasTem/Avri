{
  "name": "avri",
  "version": "0.1.0",
  "private": true,
  "description": "Your desktop AI assistant",
  "author": "Yelzhas",
  "homepage": "https://github.com/YelzhasTem/Avri",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "dist": "npm run build && npx --yes electron-builder@26.0.12 --publish never",
    "dist:mac": "npm run build && npx --yes electron-builder@26.0.12 --mac --publish never",
    "dist:win": "npm run build && npx --yes electron-builder@26.0.12 --win --publish never",
    "dist:linux": "npm run build && npx --yes electron-builder@26.0.12 --linux --publish never"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@google/genai": "^2.13.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
